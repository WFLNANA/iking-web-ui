{
  "version": "0.0.10",
  "private": false,
  "workspaces": [
    "src/*",
    "examples"
  ],
  "scripts": {
    "dev": "pnpm --dir examples serve",
    "clean": "pnpm run clean:dist && pnpm run -r --parallel clean",
    "clean:dist": "rimraf dist",
    "format": "prettier --write --cache .",
    "lint": "eslint . --ext .vue,.js,.ts,.jsx,.tsx,.md,.json --max-warnings 0 --cache",
    "typecheck:web": "vue-tsc -p tsconfig.json --composite false --noEmit",
    "stub": "pnpm run -r --parallel stub",
    "bulid:components": "node ./build/index.ts",
    "build": "pnpm run bulid:components",
    "postpub": "node ./build/update-version.ts",
    "pub": "cd iking-web-ui-pro && npm publish --access public"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@iking-ui/components": "workspace:*",
    "@iking-ui/enum": "workspace:*",
    "@iking-ui/utils": "workspace:*",
    "@monaco-editor/loader": "^1.4.0",
    "@onlyoffice/document-editor-vue": "^1.4.0",
    "@tinymce/tinymce-vue": "^5.1.1",
    "@vue/compiler-sfc": "^3.4.27",
    "@vue/runtime-core": "^3.4.27",
    "@vueuse/core": "^9.13.0",
    "fs-extra": "^10.1.0",
    "iking-admin-style": "^0.0.17",
    "less": "^4.2.0",
    "less-loader": "^11.1.4",
    "monaco-editor": "^0.47.0",
    "tinymce": "^7.1.1",
    "typescript": "^5.4.5",
    "unocss": "^0.58.9",
    "vue-router": "^4.3.2"
  },
  "devDependencies": {
    "@esbuild-kit/cjs-loader": "^2.4.4",
    "@pnpm/find-workspace-packages": "^4.0.43",
    "@pnpm/logger": "^4.0.0",
    "@pnpm/types": "^8.10.0",
    "@rollup/plugin-commonjs": "^24.1.0",
    "@types/fs-extra": "^9.0.13",
    "@types/node": "^20.14.0",
    "@types/sass": "^1.45.0",
    "@vitejs/plugin-vue": "^4.6.2",
    "@vitejs/plugin-vue-jsx": "^3.1.0",
    "@vue/tsconfig": "^0.1.3",
    "axios": "^1.7.2",
    "element-plus": "^2.7.4",
    "eslint": "^8.57.0",
    "eslint-define-config": "^1.24.1",
    "expect-type": "^0.13.0",
    "fast-glob": "^3.3.2",
    "iking-utils-pro": "^1.0.2",
    "npm-run-all": "^4.1.5",
    "prettier": "^2.8.8",
    "puppeteer": "^17.1.3",
    "resize-observer-polyfill": "^1.5.1",
    "rimraf": "^3.0.2",
    "sass": "^1.77.4",
    "sass-loader": "^13.3.3",
    "ts-morph": "^14.0.0",
    "tsx": "^3.14.0",
    "type-fest": "^2.19.0",
    "typescript": "^5.0.4",
    "unplugin-vue-macros": "^0.11.2",
    "vite": "^4.5.3",
    "vite-plugin-dts": "^3.9.1",
    "vite-plugin-static-copy": "^0.13.1",
    "vue": "^3.4.27",
    "vue-tsc": "^1.8.27",
    "xgplayer": "^3.0.18"
  },
  "engines": {
    "node": ">= 16"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "vite",
        "react",
        "react-dom"
      ]
    }
  },
  "lint-staged": {
    "*.{vue,js,ts,jsx,tsx,md,json}": "eslint --fix"
  }
}